{
    "plugins": ["typescript", "react", "unicorn", "import", "jsx-a11y"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/tabindex-no-positive": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn"
    },
    "env": {
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": ["vendor", "node_modules", "public", "bootstrap/ssr", "resources/js/wayfinder"]
}
